PORT=5000
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/relay
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated list of frontend origins allowed to call the API (no trailing slash)
CLIENT_URL=http://localhost:3000
# Set to "production" on Render (enables Secure + SameSite=None cookies)
NODE_ENV=development
